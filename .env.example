# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-character-secret
ADMIN_PASSWORD=change-me
# Set true only behind HTTPS. Leave unset/false for http://IP:3000 or admin Save will drop the session.
# COOKIE_SECURE=false

# Database
# Docker Compose postgres:
# DATABASE_URL=postgresql://vibe:vibe@localhost:5432/vibecodingdiscover
# Local Homebrew Postgres:
DATABASE_URL=postgresql://USER@localhost:5432/vibecodingdiscover

# GitHub (recommended; unauthenticated is 60 req/hour)
GITHUB_TOKEN=

# AI — OpenAI-compatible. OpenAI default, swap base URL for OpenAI/Claude-compatible gateways.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-6-luna

# X / Twitter (optional paid API). Without it, oEmbed + GitHub URL fallback is used.
X_BEARER_TOKEN=

# YouTube (optional). Without it, watch-page HTML fallback is used to read the description.
YOUTUBE_API_KEY=

# Auto-discovery (worker). GitHub Search + X recent search, hourly by default.
DISCOVER_ENABLED=true
DISCOVER_MIN_STARS=100
DISCOVER_GITHUB_LIMIT=30
DISCOVER_X_LIMIT=20
DISCOVER_TRENDING_LIMIT=25
DISCOVER_MS=300000

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Error monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# VIBECD claim (Base Sepolia testnet)
# Generate a signer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAIM_SIGNER_PRIVATE_KEY=
CLAIM_SIGNER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_VIBECD_TOKEN_ADDRESS=
NEXT_PUBLIC_VIBECD_CLAIM_ADDRESS=
NEXT_PUBLIC_VIBECD_REWARDS_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Etherscan API V2 key for contract verification (https://etherscan.io/apidashboard)
ETHERSCAN_API_KEY=
