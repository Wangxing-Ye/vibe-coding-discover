generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  draft
  published
  rejected
}

enum Category {
  AI_AGENTS
  MCP
  AI_TOOLS
  AI_CODING
  RAG
  SKILLS
  AI_FRAMEWORKS
}

enum SourceType {
  github
  x
  youtube
  trending
}

enum SubmissionStatus {
  pending
  analyzing
  needs_review
  published
  rejected
}

enum SyncJobType {
  github_fetch
  x_extract
  youtube_extract
  ai_analysis
  star_refresh
  import
  discover
}

enum SyncStatus {
  pending
  running
  success
  failed
}

enum ReanalyzeJobStatus {
  pending
  running
  paused
  stopped
  completed
  failed
}

model Project {
  id              String        @id @default(cuid())
  githubUrl       String        @unique
  owner           String
  repoName        String
  slug            String        @unique
  description     String?
  stars           Int           @default(0)
  forks           Int           @default(0)
  language        String?
  license         String?
  topics          String[]      @default([])
  readmeExcerpt   String?       @db.Text
  lastCommitAt    DateTime?
  githubCreatedAt DateTime?
  githubUpdatedAt DateTime?
  status          ProjectStatus @default(draft)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  analysis        ProjectAnalysis?
  submissions     Submission[]
  useCaseLinks    ProjectUseCase[]
  todayRecommendations TodayRecommendation[]

  @@index([status, stars])
  @@index([status, createdAt])
  @@index([owner, repoName])
  @@map("projects")
}

model ProjectAnalysis {
  id              String   @id @default(cuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectType     String
  category        Category
  tags            String[] @default([])
  frameworks      String[] @default([])
  models          String[] @default([])
  capabilities    String[] @default([])
  useCases        String[] @default([])
  aiSummary       String   @db.Text
  inScope         Boolean  @default(true)
  analyzedAt      DateTime @default(now())
  analysisVersion Int      @default(1)

  @@index([category])
  @@map("project_analysis")
}

model Submission {
  id             String           @id @default(cuid())
  sourceType     SourceType
  sourceUrl      String
  githubUrl      String?
  submitterEmail String?
  submitterIp    String?
  status         SubmissionStatus @default(pending)
  notes          String?          @db.Text
  projectId      String?
  project        Project?         @relation(fields: [projectId], references: [id])
  submittedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  reward         SubmissionReward?

  @@index([status, submittedAt])
  @@index([submitterIp, submittedAt])
  @@map("submissions")
}

model SyncLog {
  id        String      @id @default(cuid())
  jobType   SyncJobType
  target    String
  status    SyncStatus  @default(pending)
  error     String?     @db.Text
  payload   Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([jobType, createdAt])
  @@map("sync_logs")
}

model UseCase {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  projectCount Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  projects     ProjectUseCase[]

  @@index([projectCount])
  @@map("use_cases")
}

model ProjectUseCase {
  projectId String
  useCaseId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  useCase   UseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, useCaseId])
  @@index([useCaseId])
  @@map("project_use_cases")
}

model ReanalyzeJob {
  id               String             @id @default(cuid())
  status           ReanalyzeJobStatus @default(pending)
  total            Int                @default(0)
  done             Int                @default(0)
  failedCount      Int                @default(0)
  cursor           Int                @default(0)
  projectIds       String[]           @default([])
  currentProjectId String?
  currentLabel     String?
  lastError        String?            @db.Text
  events           Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, createdAt])
  @@map("reanalyze_jobs")
}

model TodayRecommendation {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectName String
  stars       Int
  todayStars  Int      @default(0)
  source      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, projectId])
  @@index([date, stars])
  @@index([date, todayStars])
  @@map("today_recommendations")
}

model ClaimIpDay {
  id        String   @id @default(cuid())
  ip        String
  day       Int
  wallet    String?
  nonce     String
  createdAt DateTime @default(now())

  @@unique([ip, day])
  @@index([day])
  @@map("claim_ip_days")
}

model SubmissionReward {
  id           String     @id @default(cuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  ip           String
  day          Int
  amount       String     @default("20000")
  /// pending | issued | claimed
  status       String     @default("pending")
  nonce        String?
  claimWallet  String?
  issuedAt     DateTime?
  claimedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([ip, day])
  @@index([status, ip])
  @@map("submission_rewards")
}

model XWatchAccount {
  id            String    @id @default(cuid())
  username      String    @unique
  enabled       Boolean   @default(true)
  notes         String?
  lastCheckedAt DateTime?
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled, username])
  @@map("x_watch_accounts")
}
